{
  "name": "@johnsonspirit/ocean-wave-theme",
  "version": "1.1.0",
  "type": "module",
  "icon": "./icon.svg",
  "description": "Animated ocean waves with a whale swimming behind the page, plus translucent surfaces.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnsonspirit/ocean-wave-theme.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "theme",
    "ocean",
    "waves",
    "backdrop"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "icon.svg",
    "locale/*.json",
    "README.md",
    "LICENSE",
    "screenshots.json",
    "assets/*.png"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-layout"]
    }
  }
}
