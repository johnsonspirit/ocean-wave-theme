{
  "name": "@local/ocean-waves-theme",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "icon": "./icon.svg",
  "description": "Animated ocean waves across the entire app background, with translucent surfaces.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "icon.svg",
    "locale/*.json"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-layout"]
    }
  }
}
